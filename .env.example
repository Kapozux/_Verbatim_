# Copy this to .env and fill in. All values are optional except where noted.

# --- Cloud engines (leave blank to use only local Whisper) ---
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# --- Security ---
# REQUIRED before exposing to the internet. Set a long random string; then
# visit  http://your-host:5001/?token=THAT_STRING  once (it's saved as a cookie).
# Leave blank for local-only use.
GETAUDIO_TOKEN=

# --- yt-dlp cookies (Channel Pipeline) ---
# On a Mac running locally, "chrome" borrows your browser login (fixes Bilibili
# 412, raises YouTube limits). In Docker there is no browser — leave this EMPTY.
# To use logins on a server, mount a cookies.txt and point yt-dlp at it instead.
YTDLP_COOKIES_BROWSER=

# --- Misc ---
# Whisper language: leave blank for auto-detect, or e.g. zh / en / ja.
# (Keep comments on their own lines — some env-file parsers keep inline text.)
WHISPER_LANGUAGE=
# 0 = production (no debugger). Docker sets this already.
FLASK_DEBUG=0
