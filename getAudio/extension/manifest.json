{
  "manifest_version": 3,
  "name": "Verbatim",
  "description": "One click on a video page: your local Verbatim downloads and transcribes it in the background.",
  "version": "0.1.0",
  "key": "",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Verbatim"},
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications", "storage", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "transcribe-page": {
      "suggested_key": {"default": "Alt+Shift+V"},
      "description": "Transcribe this video"
    }
  }
}
